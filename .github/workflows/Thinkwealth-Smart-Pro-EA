//====================================================================
// PIP SIZE
//====================================================================

double PipSize()
{
   int digits = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);

   if(digits == 3 || digits == 5)
      return(_Point * 10.0);

   return(_Point);
}

//====================================================================
// NORMALIZE LOT
//====================================================================

double NormalizeLot(double lot)
{
   double minLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double maxLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);

   if(lotStep <= 0)
      lotStep = 0.01;

   lot = MathMax(lot, minLot);
   lot = MathMin(lot, maxLot);
   lot = MathMin(lot, MaxLot);

   lot = MathFloor(lot / lotStep) * lotStep;

   int volumeDigits = 2;

   if(lotStep == 1.0)
      volumeDigits = 0;
   else if(lotStep == 0.1)
      volumeDigits = 1;
   else if(lotStep == 0.01)
      volumeDigits = 2;
   else if(lotStep == 0.001)
      volumeDigits = 3;

   return NormalizeDouble(lot, volumeDigits);
}

//====================================================================
// CALCULATE LOT SIZE FROM RISK
//====================================================================

double CalculateLotSize(double stopDistance)
{
   if(!UseRiskPercent)
      return NormalizeLot(FixedLot);

   if(stopDistance <= 0)
      return NormalizeLot(FixedLot);

   double balance = AccountInfoDouble(ACCOUNT_BALANCE);
   double riskMoney = balance * RiskPercent / 100.0;

   double tickSize  = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   double tickValue = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);

   if(tickSize <= 0 || tickValue <= 0)
      return NormalizeLot(FixedLot);

   double lossPerLot = (stopDistance / tickSize) * tickValue;

   if(lossPerLot <= 0)
      return NormalizeLot(FixedLot);

   double lot = riskMoney / lossPerLot;

   return NormalizeLot(lot);
}

//====================================================================
// CHECK TRADING HOURS
//====================================================================

bool IsTradingHour()
{
   if(!UseTradingHours)
      return true;

   MqlDateTime currentTime;
   TimeToStruct(TimeCurrent(), currentTime);

   int hour = currentTime.hour;

   if(StartHour < EndHour)
   {
      if(hour >= StartHour && hour < EndHour)
         return true;
   }
   else
   {
      if(hour >= StartHour || hour < EndHour)
         return true;
   }

   return false;
}

//====================================================================
// CHECK SPREAD
//====================================================================

bool IsSpreadOK()
{
   if(!UseSpreadFilter)
      return true;

   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);

   if(ask <= 0 || bid <= 0)
      return false;

   double spreadPips = (ask - bid) / PipSize();

   return(spreadPips <= MaxSpreadPips);
}

//====================================================================
// CHECK EXISTING POSITION
//====================================================================

bool HasOpenPosition()
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol = PositionGetString(POSITION_SYMBOL);
      ulong magic   = (ulong)PositionGetInteger(POSITION_MAGIC);

      if(symbol == _Symbol && magic == MagicNumber)
         return true;
   }

   return false;
}

//====================================================================
// GET INDICATOR VALUES
//====================================================================

bool GetIndicatorValues(
   double &fastEMA,
   double &slowEMA,
   double &macdMain,
   double &macdSignal,
   double &stochMain,
   double &stochSignal,
   double &atrValue
)
{
   double emaFastBuffer[3];
   double emaSlowBuffer[3];

   double macdMainBuffer[3];
   double macdSignalBuffer[3];

   double stochMainBuffer[3];
   double stochSignalBuffer[3];

   double atrBuffer[3];

   ArraySetAsSeries(emaFastBuffer, true);
   ArraySetAsSeries(emaSlowBuffer, true);
   ArraySetAsSeries(macdMainBuffer, true);
   ArraySetAsSeries(macdSignalBuffer, true);
   ArraySetAsSeries(stochMainBuffer, true);
   ArraySetAsSeries(stochSignalBuffer, true);
   ArraySetAsSeries(atrBuffer, true);

   if(CopyBuffer(hFastEMA, 0, 0, 3, emaFastBuffer) < 3)
      return false;

   if(CopyBuffer(hSlowEMA, 0, 0, 3, emaSlowBuffer) < 3)
      return false;

   if(CopyBuffer(hMACD, 0, 0, 3, macdMainBuffer) < 3)
      return false;

   if(CopyBuffer(hMACD, 1, 0, 3, macdSignalBuffer) < 3)
      return false;

   if(CopyBuffer(hStoch, 0, 0, 3, stochMainBuffer) < 3)
      return false;

   if(CopyBuffer(hStoch, 1, 0, 3, stochSignalBuffer) < 3)
      return false;

   if(CopyBuffer(hATR, 0, 0, 3, atrBuffer) < 3)
      return false;

   // Use the last completed candle
   fastEMA    = emaFastBuffer[1];
   slowEMA    = emaSlowBuffer[1];

   macdMain   = macdMainBuffer[1];
   macdSignal = macdSignalBuffer[1];

   stochMain  = stochMainBuffer[1];
   stochSignal= stochSignalBuffer[1];

   atrValue   = atrBuffer[1];

   return true;
}

//====================================================================
// BUY SIGNAL
//====================================================================

bool BuySignal()
{
   double fastEMA;
   double slowEMA;
   double macdMain;
   double macdSignal;
   double stochMain;
   double stochSignal;
   double atrValue;

   if(!GetIndicatorValues(
      fastEMA,
      slowEMA,
      macdMain,
      macdSignal,
      stochMain,
      stochSignal,
      atrValue))
      return false;

   double closePrice = iClose(_Symbol, PERIOD_CURRENT, 1);

   // Trend condition
   bool bullishTrend = 
      fastEMA > slowEMA &&
      closePrice > fastEMA;

   // MACD condition
   bool bullishMACD =
      macdMain > macdSignal &&
      macdMain > 0;

   // Stochastic condition
   bool bullishStoch =
      stochMain > stochSignal &&
      stochMain < StochOverbought;

   if(bullishTrend && bullishMACD && bullishStoch)
      return true;

   return false;
}

//====================================================================
// SELL SIGNAL
//====================================================================

bool SellSignal()
{
   double fastEMA;
   double slowEMA;
   double macdMain;
   double macdSignal;
   double stochMain;
   double stochSignal;
   double atrValue;

   if(!GetIndicatorValues(
      fastEMA,
      slowEMA,
      macdMain,
      macdSignal,
      stochMain,
      stochSignal,
      atrValue))
      return false;

   double closePrice = iClose(_Symbol, PERIOD_CURRENT, 1);

   // Trend condition
   bool bearishTrend =
      fastEMA < slowEMA &&
      closePrice < fastEMA;

   // MACD condition
   bool bearishMACD =
      macdMain < macdSignal &&
      macdMain < 0;

   // Stochastic condition
   bool bearishStoch =
      stochMain < stochSignal &&
      stochMain > StochOversold;

   if(bearishTrend && bearishMACD && bearishStoch)
      return true;

   return false;
}

//====================================================================
// CALCULATE BUY SL
//====================================================================

double CalculateBuySL(double entryPrice, double atrValue)
{
   double slDistance;

   if(UseATRStops && atrValue > 0)
      slDistance = atrValue * ATR_SL_Multiplier;
   else
      slDistance = FixedStopLossPips * PipSize();

   double sl = entryPrice - slDistance;

   return NormalizeDouble(sl, _Digits);
}

//====================================================================
// CALCULATE BUY TP
//====================================================================

double CalculateBuyTP(double entryPrice, double atrValue)
{
   double tpDistance;

   if(UseATRStops && atrValue > 0)
      tpDistance = atrValue * ATR_TP_Multiplier;
   else
      tpDistance = FixedTakeProfitPips * PipSize();

   double tp = entryPrice + tpDistance;

   return NormalizeDouble(tp, _Digits);
}

//====================================================================
// CALCULATE SELL SL
//====================================================================

double CalculateSellSL(double entryPrice, double atrValue)
{
   double slDistance;

   if(UseATRStops && atrValue > 0)
      slDistance = atrValue * ATR_SL_Multiplier;
   else
      slDistance = FixedStopLossPips * PipSize();

   double sl = entryPrice + slDistance;

   return NormalizeDouble(sl, _Digits);
}

//====================================================================
// CALCULATE SELL TP
//====================================================================

double CalculateSellTP(double entryPrice, double atrValue)
{
   double tpDistance;

   if(UseATRStops && atrValue > 0)
      tpDistance = atrValue * ATR_TP_Multiplier;
   else
      tpDistance = FixedTakeProfitPips * PipSize();

   double tp = entryPrice - tpDistance;

   return NormalizeDouble(tp, _Digits);
}

//====================================================================
// OPEN BUY
//====================================================================

void OpenBuy()
{
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);

   if(ask <= 0)
      return;

   double fastEMA;
   double slowEMA;
   double macdMain;
   double macdSignal;
   double stochMain;
   double stochSignal;
   double atrValue;

   if(!GetIndicatorValues(
      fastEMA,
      slowEMA,
      macdMain,
      macdSignal,
      stochMain,
      stochSignal,
      atrValue))
      return;

   double sl = CalculateBuySL(ask, atrValue);
   double tp = CalculateBuyTP(ask, atrValue);

   double stopDistance = ask - sl;

   if(stopDistance <= 0)
      return;

   double lot = CalculateLotSize(stopDistance);

   if(lot <= 0)
      return;

   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(20);

   bool result = trade.Buy(
      lot,
      _Symbol,
      ask,
      sl,
      tp,
      "Thinkwealth BUY"
   );

   if(result)
   {
      Print(
         "Thinkwealth EA BUY opened. Lot=",
         lot,
         " SL=",
         sl,
         " TP=",
         tp
      );
   }
   else
   {
      Print(
         "BUY failed. Retcode=",
         trade.ResultRetcode(),
         " Description=",
         trade.ResultRetcodeDescription()
      );
   }
}

//====================================================================
// OPEN SELL
